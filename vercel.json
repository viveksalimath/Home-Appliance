{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "shop.ttkMetalora.com/**",
          "fonts.googleapis.com/**",
          "video.lively.li/**",
          "unpkg.com/**",
          "code.ionicframework.com/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
